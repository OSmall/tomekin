{
  "name": "tomekin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    ".opencode"
  ],
  "scripts": {
    "db:sqlite:migration:apply": "bun packages/sqlite/src/apply-migrations.ts",
    "db:sqlite:migration:prepare-card-set-search": "bun packages/sqlite/src/prepare-card-set-migration.ts",
    "db:sqlite:migration:generate": "bun run --cwd packages/sqlite drizzle-kit generate",
    "import:collection": "bun packages/cli/src/import-collection.ts",
    "import:scryfall": "bun packages/cli/src/import-scryfall.ts",
    "sync:scryfall": "bun packages/cli/src/sync-scryfall.ts",
    "tomekin": "bun packages/pi/src/run.ts",
    "test": "bun test",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.13",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
